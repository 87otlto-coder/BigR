{
  "name": "bigr-pixel-core",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, asset-level nearest-neighbor scaling for indexed and RGBA pixel art",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test tests/core.test.ts",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": { "typescript": "^5.8.3" },
  "engines": { "node": ">=22" }
}
